        <mxCell id="twhead" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontColor=#111111;" value="&lt;b&gt;CONSTANTES DOS TWIDDLES — DFT E IDFT&lt;/b&gt;" vertex="1">
          <mxGeometry height="35" width="1780" x="50" y="650" as="geometry" />
        </mxCell>
        <mxCell id="twtable" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#777777;strokeWidth=1.5;fontSize=15;align=center;verticalAlign=middle;" value="&lt;b&gt;DFT (W₈ᵏ)&lt;/b&gt;&lt;br&gt;W₈⁰ = 1&lt;br&gt;W₈¹ = 0,7071 − j0,7071&lt;br&gt;W₈² = −j&lt;br&gt;W₈³ = −0,7071 − j0,7071&lt;br&gt;&lt;br&gt;&lt;b&gt;IDFT (conjugados)&lt;/b&gt;&lt;br&gt;W₈⁰* = 1&lt;br&gt;W₈¹* = 0,7071 + j0,7071&lt;br&gt;W₈²* = +j&lt;br&gt;W₈³* = −0,7071 + j0,7071" vertex="1">
          <mxGeometry height="250" width="550" x="50" y="690" as="geometry" />
        </mxCell>
        <mxCell id="w0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2f0d9;strokeColor=#6b8e23;strokeWidth=1.5;fontSize=15;align=center;verticalAlign=middle;" value="&lt;b&gt;W0 = 1&lt;/b&gt;&lt;br&gt;T = B&lt;br&gt;Sem multiplicador: fios diretos" vertex="1">
          <mxGeometry height="105" width="300" x="680" y="690" as="geometry" />
        </mxCell>
        <mxCell id="w2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2f0d9;strokeColor=#6b8e23;strokeWidth=1.5;fontSize=15;align=center;verticalAlign=middle;" value="&lt;b&gt;W2 = −j&lt;/b&gt;&lt;br&gt;DFT: T = bi − j·br&lt;br&gt;IDFT: T = −bi + j·br&lt;br&gt;Troca real/imag. e sinais" vertex="1">
          <mxGeometry height="125" width="350" x="1030" y="690" as="geometry" />
        </mxCell>
        <mxCell id="w13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9eaf7;strokeColor=#3973a5;strokeWidth=1.5;fontSize=15;align=center;verticalAlign=middle;" value="&lt;b&gt;W1 / W3&lt;/b&gt;&lt;br&gt;Multiplicação complexa por constante&lt;br&gt;Implementação em Q1.14&lt;br&gt;multiplicação + deslocamento &gt;&gt;&gt;14" vertex="1">
          <mxGeometry height="125" width="380" x="1430" y="690" as="geometry" />
        </mxCell>
        <mxCell id="qnote" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#b38b00;fontSize=14;align=left;verticalAlign=middle;" value="&lt;b&gt;Nota de implementação:&lt;/b&gt; os coeficientes 0,7071 são aproximados em Q1.14 (±11585)." vertex="1">
          <mxGeometry height="100" width="550" x="50" y="980" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
