transcript on
if {[file exists rtl_work]} {
	vdel -lib rtl_work -all
}
vlib rtl_work
vmap work rtl_work

vlog  -work work +incdir+C:/camis/DFT_IDFT_Convolucao_FPGA/DFT_IDFT {C:/camis/DFT_IDFT_Convolucao_FPGA/DFT_IDFT/cmulW1.v}
vlog  -work work +incdir+C:/camis/DFT_IDFT_Convolucao_FPGA/DFT_IDFT {C:/camis/DFT_IDFT_Convolucao_FPGA/DFT_IDFT/butterflyW1.v}

vlog  -work work +incdir+C:/camis/DFT_IDFT_Convolucao_FPGA/DFT_IDFT {C:/camis/DFT_IDFT_Convolucao_FPGA/DFT_IDFT/tb_butterflyW3.v}

vsim -t 1ps -L altera_ver -L lpm_ver -L sgate_ver -L altera_mf_ver -L altera_lnsim_ver -L fiftyfivenm_ver -L rtl_work -L work -voptargs="+acc"  tb_butterflyW3

add wave *
view structure
view signals
run -all
